{
  "expo": {
    "name": "Oracle CDL",
    "displayName": "Oracle CDL",
    "slug": "OracleClefsDeLumiere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oracleclefsdelumiere",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "ch.smeusling.oracleclefsdelumiere",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "ch.smeusling.oracleclefsdelumiere"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/clef.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FAF0EE",
          "dark": {
            "backgroundColor": "#FAF0EE"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fed5e778-a7a7-4985-88d9-f9392402fafb"
      }
    }
  }
}
